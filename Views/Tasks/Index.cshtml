@model TaskListViewModel
@{
    ViewData["Title"] = "Task Siyahısı";

    string NextOrder(string field) =>
        Model.SortBy == field && Model.SortOrder == "asc" ? "desc" : "asc";

    string SortIcon(string field) => Model.SortBy == field
        ? (Model.SortOrder == "asc" ? "bi-sort-up" : "bi-sort-down")
        : "bi-arrow-down-up text-muted";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="bi bi-list-task me-2 text-primary"></i>Task Siyahısı</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Yeni Task
    </a>
</div>

@if (!Model.Tasks.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-inbox display-3 d-block mb-3"></i>
        <p class="fs-5">Heç bir task tapılmadı.</p>
        <a asp-action="Create" class="btn btn-primary mt-2">İlk task-ı yarat</a>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Başlıq</th>
                        <th>
                            <a asp-action="Index"
                               asp-route-sortBy="priority"
                               asp-route-sortOrder="@NextOrder("priority")"
                               class="text-decoration-none text-dark">
                                Priority <i class="bi @SortIcon("priority")"></i>
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index"
                               asp-route-sortBy="deadline"
                               asp-route-sortOrder="@NextOrder("deadline")"
                               class="text-decoration-none text-dark">
                                Deadline <i class="bi @SortIcon("deadline")"></i>
                            </a>
                        </th>
                        <th>Status</th>
                        <th>Əməliyyatlar</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var task in Model.Tasks)
                    {
                        @await Html.PartialAsync("_TaskRow", task)
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3 text-muted small">
        Cəmi: <strong>@Model.Tasks.Count()</strong>
        &nbsp;|&nbsp; Tamamlanmış: <strong class="text-success">@Model.Tasks.Count(t => t.IsCompleted)</strong>
        &nbsp;|&nbsp;
        <span class="text-danger">
            Overdue: <strong>@Model.Tasks.Count(t => t.Status == WorkStatus.Overdue)</strong>
        </span>
    </div>
}
